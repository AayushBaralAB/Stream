# AB Streaming Software — server configuration
# Copy this file to `.env` on the server (git-ignored) and fill in real values.
# See AZURE_DEPLOYMENT.md for the full deployment walkthrough.

# ---------- REQUIRED ----------

# Random 32+ char string. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Admin login username
ADMIN_USERNAME=

# Plaintext admin password. The server hashes it on first boot and
# compares against ADMIN_PASSWORD_HASH when set (hash wins).
# Generate the hash with: npm run generate-password
ADMIN_PASSWORD=

# ---------- OPTIONAL ----------

NODE_ENV=production
HOST=0.0.0.0
PORT=3000
BASE_PATH=
TZ=Asia/Kathmandu
COOKIE_SECURE=
SESSION_TTL_SECONDS=
MONGODB_URI=
MONGODB_DB=ab_streaming
UPLOAD_DIR=
DATA_DIR=
MAX_FILE_SIZE=
FFMPEG_PATH=
FFMPEG_MAX_RESTARTS=
FFMPEG_RESTART_DELAY_MS=
IDEAL_STREAMS=
WATCHDOG_INTERVAL_MS=
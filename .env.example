PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=aayush_live
JWT_SECRET=your-super-secret-jwt-key-change-this
APP_URL=https://stream.aayushbaral.com
UPLOAD_DIR=/data/videos
LOGO_DIR=/data/logos
HLS_DIR=/data/hls
# ENCRYPTION_KEY formats (both are accepted, never mixed):
#   1) 64-char hex = an exact 32-byte AES-256 key:  openssl rand -hex 32
#   2) any printable string >= 16 chars (passphrase, SHA-256-derived to 32 bytes)
# Never rotate this value after destinations are saved or their keys can't be decrypted.
ENCRYPTION_KEY=your-64-hex-or-16plus-character-encryption-key
NODE_ENV=production
# Optional: TTF/OTF used by the on-video news ticker + clock (drawtext).
# Windows default: C:\Windows\Fonts\arial.ttf (or mangal.ttf for Devanagari)
# Docker default:  /usr/share/fonts/dejavu/DejaVuSans.ttf (installed in backend image)
#TICKER_FONT=C:\Windows\Fonts\mangal.ttf
# Optional: IANA timezone rendered by the clock burned into the video (default Asia/Kathmandu).
#STREAM_TIMEZONE=Asia/Kathmandu
# Optional: path to the yt-dlp binary. If unset, "yt-dlp" on PATH is tried, then
# "python -m yt_dlp". Used to resolve YouTube / Facebook / TikTok sources.
#YTDLP_PATH=C:\tools\yt-dlp.exe